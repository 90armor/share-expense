{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git show:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run build)"
    ]
  }
}
