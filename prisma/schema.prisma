// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Group {
  id          String       @id @default(uuid(4))
  name        String
  currency    String
  createdAt   DateTime     @default(now())
  members     Member[]
  expenses    Expense[]
  settlements Settlement[]
}

model Member {
  id                  String               @id @default(uuid(4))
  groupId             String
  group               Group                @relation(fields: [groupId], references: [id])
  name                String
  /// Normalized name (NFC, whitespace collapsed, lowercased), set by the member service only.
  nameKey             String
  createdAt           DateTime             @default(now())
  /// Restrict on all: a member who paid for or shares an expense, or paid or
  /// received a settlement, cannot be removed.
  paidExpenses        Expense[]            @relation("ExpensePayer")
  participations      ExpenseParticipant[]
  settlementsPaid     Settlement[]         @relation("SettlementFrom")
  settlementsReceived Settlement[]         @relation("SettlementTo")

  @@unique([groupId, nameKey])
}

/// Equal sharing between participants; no per-person amounts are stored.
model Expense {
  id           String               @id @default(uuid(4))
  groupId      String
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payerId      String
  payer        Member               @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  /// Minor units (1/100). Currency is the group's, not stored per expense.
  amount       BigInt
  /// Trimmed; blank is stored as null.
  description  String?
  createdAt    DateTime             @default(now())
  participants ExpenseParticipant[]

  @@index([groupId])
  @@index([payerId])
}

/// Who shares an expense. The composite id makes each member appear once per expense.
model ExpenseParticipant {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([expenseId, memberId])
  @@index([memberId])
}

/// A recorded payment: `from` paid `to` `amount`. Immutable (no edit/delete/undo in the MVP).
model Settlement {
  id        String   @id @default(uuid(4))
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// Who paid (credited in the balance).
  fromId    String
  from      Member   @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: Restrict)
  /// Who received (debited in the balance).
  toId      String
  to        Member   @relation("SettlementTo", fields: [toId], references: [id], onDelete: Restrict)
  /// Minor units (1/100). Currency is the group's, not stored per settlement.
  amount    BigInt
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([fromId])
  @@index([toId])
}
